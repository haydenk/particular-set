# https://git-scm.com/docs/gitattributes
#
# Two concerns here:
#   1. Line endings — normalise everything to LF, in the repo and on
#      checkout. Mixed line endings break shell scripts and Go tooling.
#   2. Archive contents — when GitHub generates the Source-code zip or
#      tarball (`git archive`), strip everything that's only useful for
#      repo development, leaving the skill specs and consumer-facing
#      docs.

# ---------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------

# Default: let git detect text vs binary, force LF on text.
* text=auto eol=lf

# Source
*.go      text eol=lf
*.sh      text eol=lf
*.fish    text eol=lf

# Docs
*.md      text eol=lf diff=markdown

# Config
*.json    text eol=lf
*.jsonc   text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Files without an extension we ship as scripts.
.githooks/pre-commit       text eol=lf
.mise/tasks/install-hooks  text eol=lf

# Binary assets — never normalise.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary

# ---------------------------------------------------------------------
# Excluded from `git archive` (GitHub source-code zip/tarball)
# ---------------------------------------------------------------------
#
# Keep: README.md, AGENT.md, CLAUDE.md, LICENSE, SECURITY.md,
# CODE_OF_CONDUCT.md, docs/, skills/, .claude-plugin/.

# Directories: match the dir itself and every path beneath it.
.claude/**                 export-ignore
.dagger/**                 export-ignore
.githooks/**               export-ignore
.github/**                 export-ignore
.mise/**                   export-ignore

# Bare files.
.editorconfig              export-ignore
.gitattributes             export-ignore
.gitignore                 export-ignore
.markdownlint-cli2.jsonc   export-ignore
dagger.json                export-ignore
.mise.toml                  export-ignore
